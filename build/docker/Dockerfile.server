# Code CAD Studio Server Mode Dockerfile
# 3-stage build producing a runnable headless HTTP server with embedded frontend
# assets and a Python 3.12 + build123d + ocp_tessellate runtime environment.
#
# Build:
#   docker build -t code-cad-studio:latest -f build/docker/Dockerfile.server .
#
# Run (mount your local CAD models directory to /projects):
#   docker run --rm -p 8080:8080 -v /path/to/models:/projects code-cad-studio:latest

ARG NODE_IMAGE=node:22-bookworm-slim
ARG GO_IMAGE=golang:1.26-bookworm
ARG RUNTIME_IMAGE=debian:bookworm-slim
ARG CGO_ENABLED=0

# Stage 1: Build production frontend assets (embedded into the Go binary)
FROM ${NODE_IMAGE} AS frontend-builder

WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# Stage 2: Build the production Go server binary (-tags server,production)
FROM ${GO_IMAGE} AS go-builder
ARG CGO_ENABLED

WORKDIR /src
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    $([ "$CGO_ENABLED" = "1" ] && echo "gcc libc6-dev") \
    && rm -rf /var/lib/apt/lists/*

COPY go.mod go.sum ./
RUN go mod download

COPY . .
COPY --from=frontend-builder /src/frontend/dist ./frontend/dist

RUN sed -i '/^replace/d' go.mod || true
RUN CGO_ENABLED=${CGO_ENABLED} go build -tags server,production -trimpath -buildvcs=false -ldflags="-s -w" -o /out/code-cad-studio-server .

# Stage 3: Runtime image with OCCT system libraries + uv + Python 3.12 + build123d
FROM ${RUNTIME_IMAGE} AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libexpat1 \
    libfontconfig1 \
    libfreetype6 \
    libgl1 \
    libglu1-mesa \
    libgomp1 \
    libice6 \
    libsm6 \
    libx11-6 \
    libxext6 \
    libxi6 \
    libxrender1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.6 /uv /usr/local/bin/uv

ENV UV_PYTHON_INSTALL_DIR=/opt/code-cad-studio/python
RUN uv python install 3.12 \
    && uv venv --python 3.12 /opt/code-cad-studio/venv \
    && uv pip install --no-cache --python /opt/code-cad-studio/venv/bin/python \
        "build123d>=0.8,<1.0" \
        "ocp_tessellate>=3.0,<4.0"

COPY --from=go-builder /out/code-cad-studio-server /usr/local/bin/code-cad-studio-server

RUN groupadd --system studio \
    && useradd --system --gid studio --create-home --home-dir /home/studio --shell /usr/sbin/nologin studio \
    && mkdir -p /projects /home/studio/.config/code-cad-studio \
    && chown -R studio:studio /projects /home/studio

USER studio
WORKDIR /projects
VOLUME ["/projects"]

EXPOSE 8080

ENV WAILS_SERVER_HOST=0.0.0.0
ENV PATH="/opt/code-cad-studio/venv/bin:${PATH}"

ENTRYPOINT ["/usr/local/bin/code-cad-studio-server"]
