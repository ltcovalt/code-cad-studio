<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="code-cad-studio"
        Arguments=""
        InstallLocation="C:\Program Files\ltcovalt\Code CAD Studio">
    </Installer>
    <PackageInformation
        PackageName="Code CAD Studio"
        PackageDisplayName="Code CAD Studio"
        PublisherName="CN=ltcovalt"
        PublisherDisplayName="ltcovalt"
        Version="0.1.0.0"
        PackageDescription="Model-agnostic parametric GUI for build123d">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.ltcovalt.codecadstudio"
                Description="Model-agnostic parametric GUI for build123d"
                DisplayName="Code CAD Studio"
                ExecutableName="code-cad-studio"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Code CAD Studio</DisplayName>
            <PublisherDisplayName>ltcovalt</PublisherDisplayName>
            <Description>Model-agnostic parametric GUI for build123d</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="code-cad-studio.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
